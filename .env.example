PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warcraft_logging

# Free Warcraft Logs API client: https://www.warcraftlogs.com/api/clients
# Redirect URL can be a placeholder, e.g. http://localhost:3000/callback
# (client-credentials flow does not use the redirect)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Shared secret for POST /v1/refresh (Authorization: Bearer <token>)
REFRESH_TOKEN=change-me

# How many top score runs to keep per dungeon/spec
INGEST_LIMIT=20

# Scheduler: every N hours, ingest the next batch of specs
INGEST_CRON_HOURS=1
INGEST_SPECS_PER_TICK=6

# Stop a batch early when WCL hourly spend exceeds this ratio
WCL_RATE_LIMIT_MAX_RATIO=0.85

# 56 = Mythic+ Season 2 (PTR)
WCL_ZONE_ID=56
